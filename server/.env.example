# Copy to server/.env and fill with your AWS RDS PostgreSQL connection.
# RDS requires TLS: keep sslmode=require (verify-full also needs the RDS CA bundle).
# Example host: dpos-dev.abcdefg12345.ap-southeast-3.rds.amazonaws.com
DATABASE_URL="postgresql://USER:PASSWORD@RDS_ENDPOINT:5432/dpos?schema=public&sslmode=require"

# JWT signing secret for the API (any long random string for dev)
JWT_SECRET="change-me-to-a-long-random-dev-secret"
JWT_EXPIRES_IN="12h"

# API
PORT=3000

# Nota reader (POST /nota/read). With no key set the endpoint uses a built-in stub, so
# tests and fresh clones never make a paid call. Never commit a real key.
# Note: the photo is sent to Anthropic for extraction, i.e. it leaves ap-southeast-3.
ANTHROPIC_API_KEY=""
NOTA_VISION_MODEL="claude-sonnet-5"
# NOTA_VISION_PROVIDER="stub"   # force the stub even when a key is present
